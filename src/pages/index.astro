---
import '../styles/style.css';
const imageBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/img/`;
const drinks = [
 {id:'coffee', en:'Daily happiness', name:'本日のおすすめ',price:500,desc:'ふんわりホイップクリームをのせた、今日の気分を明るくするおすすめドリンク。',color:'#FFF0A8'},
 {id:'matcha', en:'Matcha mood',name:'抹茶フラペチーノ',price:800,desc:'香り豊かな抹茶と、なめらかなホイップクリームを楽しむ贅沢な一杯。',color:'#B8D89A'},
 {id:'strawberry', en:'Seasonal crush',name:'季節のフラペチーノ',price:500,desc:'苺とチョコレートにクリームを合わせた、華やかな季節のドリンク。',color:'#F58EA8'}
];
const gallery = [['strawberry','Strawberry Pop'],['lemon','Lemon Cream Splash'],['matcha','Matcha Mood'],['caramel','Caramel Coffee Mood'],['berry','Berry Dream'],['blue','Blue Soda Cream'],['peach','Peach Soft Latte'],['orange','Orange Sunny Float'],['chocolate','Chocolate Spark']];
const nav = [['about','ABOUT'],['menu','MENU'],['customize','CUSTOMIZE'],['access','ACCESS']];
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Aya Cafe｜今日の気分に合わせて、わたしだけの一杯を。</title>
<meta name="description" content="ドリンクをファッションのように楽しむ、架空のテイクアウトカフェ Aya Cafe。カラフルなメニューとMY DRINKシミュレーターを楽しめるポートフォリオサイトです。"/>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='32' fill='%23F58EA8'/%3E%3Ctext x='32' y='46' text-anchor='middle' font-size='45' fill='%23523429' font-family='serif'%3Ea%3C/text%3E%3C/svg%3E"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet"/>
</head>
<body>
<a href="#main" class="skip">本文へスキップ</a>
<header class="header">
<a class="logo" href="#" aria-label="Aya Cafe ホーム">aya<span>CAFE</span><i aria-hidden="true">✳</i></a>
<nav id="navigation" aria-label="メインナビゲーション">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}<a class="nav-note" href="#gallery">A LITTLE CUP OF HAPPY.</a></nav>
<button class="nav-toggle" aria-expanded="false" aria-controls="navigation" aria-label="メニューを開く" hidden><span></span><span></span></button>
</header>
<main id="main">
<section class="hero" aria-labelledby="hero-title">
<div class="hero-top"><span>TAKE A SIP. FIND YOUR COLOR.</span><span>TOKYO · TAKEAWAY CAFE</span></div>
<h1 id="hero-title" class="hero-word">AYA CAFE<span class="hero-spark" aria-hidden="true">✳</span></h1>
<div class="hero-body">
<div class="hero-copy"><p class="eyebrow">YOUR DRINK, YOUR MOOD.</p><h2>今日の気分に合わせて、<br/>わたしだけの一杯を。</h2><p class="hero-description">色も、香りも、トッピングも。<br/>好きなものを選んで、毎日をもっとカラフルに。</p><div class="hero-actions"><a class="button dark" href="#menu">VIEW MENU <span>↗</span></a><a class="text-link" href="#customize">MAKE MY DRINK <span>↗</span></a></div></div>
<div class="hero-photo"><img src={`${imageBase}hero-drink.webp`} alt="苺とチョコレート、ホイップをたっぷりのせたAya Cafeのドリンク" width="1672" height="941" fetchpriority="high"/><span class="photo-caption">A little sweet. A lot of you.</span><span class="round-sticker">SIP.<br/>SMILE.<br/>REPEAT.</span></div>
</div>
<div class="hero-bottom"><span>COFFEE, CREAM & A LITTLE DAYDREAM.</span><a href="#about">SCROLL TO EXPLORE ↓</a></div>
</section>
<div class="marquee" aria-label="SWEET! COLORFUL! ENJOY YOUR DAY!"><div class="marquee-track" aria-hidden="true">{[0,1,2,3].map(()=> <span>SWEET! <i>✳</i> COLORFUL! <i>✳</i> ENJOY YOUR DAY! <i>✳</i>&nbsp;</span>)}</div><button class="motion-toggle" aria-label="アニメーションを停止" aria-pressed="false" hidden>Ⅱ</button></div>
<section id="about" class="about section reveal"><div><p class="eyebrow">01 / OUR LITTLE STORY</p><h2 class="display">EVERY CUP IS<br/>A LITTLE <em>happiness.</em></h2></div><div class="about-copy"><h3>いつもの一日を、ちょっと特別に。</h3><p>Aya Cafeは、その日の気分に合わせてドリンクを楽しめるテイクアウトカフェ。</p><p>甘いものが飲みたい日も、少しリフレッシュしたい日も。<br/>お気に入りのカラーとトッピングを選んで、あなただけの一杯を見つけてください。</p></div><div class="values"><div><span class="value-icon circles" aria-hidden="true">●●●</span><span>CHOOSE YOUR COLOR<small>気分を、色に。</small></span></div><div><span class="value-icon" aria-hidden="true">✳</span><span>CHOOSE YOUR FLAVOR<small>好きな味を、自由に。</small></span></div><div><span class="value-icon" aria-hidden="true">♡</span><span>MAKE IT YOURS<small>仕上げは、あなたらしく。</small></span></div></div></section>
<section id="menu" class="menu section"><div class="section-heading reveal"><div><p class="eyebrow">02 / SIGNATURE MENU</p><h2 class="display">PICK YOUR <em>favorite!</em></h2></div><p>今日はどの一杯にする？</p></div>
<div class="menu-select" aria-label="商品を選択" hidden>{drinks.map((d,i)=><button type="button" data-menu={d.id} aria-pressed={i===0} aria-controls={`panel-${d.id}`}><span>0{i+1}</span>{d.name}<span class="selector-arrow">↗</span></button>)}</div>
<div class="showcase">{drinks.map((d,i)=><article class="menu-panel" id={`panel-${d.id}`} data-product={d.id} style={`--product-color:${d.color}`}><div class="menu-image"><img src={`${imageBase}menu-${d.id}.webp`} alt={d.name} width="1254" height="1254" loading="lazy"/></div><div class="menu-copy"><span class="eyebrow">AYA'S SELECTION / 0{i+1}</span><p class="serif product-english">{d.en}</p><h3>{d.name}</h3><p class="price">¥{d.price}<small> / 1 CUP</small></p><p>{d.desc}</p><a class="text-link" href="#customize">自分好みにカスタマイズ <span>↗</span></a><span class="menu-flower" aria-hidden="true">✳</span></div></article>)}</div></section>
<section id="customize" class="customize section"><div class="section-heading reveal"><div><p class="eyebrow">03 / MY DRINK STUDIO</p><h2 class="display">MAKE YOUR<br/>OWN <em>drink!</em></h2></div><div><p>気分に合わせて、カスタマイズ！</p><p class="small">選ぶ時間まで、おいしいひととき。</p></div></div><noscript><p>カスタマイズ体験にはJavaScriptを有効にしてください。商品は上のMENUでご覧いただけます。</p></noscript>
<form id="drink-form"><div class="custom-controls"><fieldset disabled><legend><span>01</span> ベースを選択</legend><div class="base-options">{[['coffee','コーヒー'],['matcha','抹茶'],['strawberry','ストロベリー']].map(([id,label],i)=><label class="choice"><input type="radio" name="base" value={id} checked={i===0}/><span class={`swatch ${id}`}></span><span>{label}</span></label>)}</div></fieldset><fieldset disabled><legend><span>02</span> トッピングを選択 <small>複数選択OK</small></legend><div class="toppings">{['ホイップクリーム','チョコレートソース','抹茶パウダー'].map((label,i)=><label class="choice"><input type="checkbox" name="topping" value={label}/><span>{label}</span><span aria-hidden="true" class="plus">＋</span></label>)}</div></fieldset><div class="custom-actions"><button class="button dark" type="submit" disabled>MY DRINK 完成！ <span>↗</span></button><button class="reset" type="reset" disabled>RESET ↺</button></div><p class="small">※ カスタマイズ体験のデモです。注文・決済・送信は行いません。</p></div><div class="drink-preview"><div class="preview-label"><span>03 / YOUR CREATION</span><span>MADE BY YOU ♡</span></div><div class="preview-image"><img id="custom-image" src={`${imageBase}menu-coffee.webp`} alt="コーヒーベースの参考イメージ" width="1254" height="1254" loading="lazy"/></div><div class="preview-info" aria-live="polite" aria-atomic="true"><h3 id="custom-name">My Coffee</h3><div id="topping-badges" class="badges"><span>トッピングなし</span></div></div><p class="small">写真はベースの参考イメージです。<br/>選んだトッピングはラベルで表示します。</p></div><div class="completion" role="status" aria-live="polite" aria-atomic="true"></div></form></section>
<section id="gallery" class="gallery section"><div class="section-heading reveal"><div><p class="eyebrow">04 / THE COLOR COLLECTION</p><h2 class="display">COLOR YOUR <em>moment.</em></h2></div><p>好きな色から、好きな一杯へ。</p></div><div class="gallery-grid">{gallery.map(([id,name],i)=><figure class="gallery-item reveal"><div><img src={`${imageBase}gallery-${id}.webp`} alt={`${name} — カラフルな背景に飾られたドリンク`} width="1254" height="1254" loading="lazy"/></div><figcaption><span>{name}</span><span>0{i+1}</span></figcaption></figure>)}</div></section>
<section id="access" class="access section reveal"><div><p class="eyebrow">05 / COME SAY HELLO!</p><h2 class="display">GOOD DAYS<br/>START WITH<br/><em>a little sip.</em></h2><span class="access-flower" aria-hidden="true">✳</span></div><div class="access-details"><h3 class="serif">Aya Cafe</h3><dl><div><dt>LOCATION</dt><dd>東京都渋谷区<br/><span class="small">架空店舗・詳細未設定</span></dd></div><div><dt>OPEN</dt><dd>9:00〜18:00</dd></div><div><dt>STYLE</dt><dd>テイクアウト専門</dd></div></dl><p class="small">このWebサイトはポートフォリオ作品です。<br/>Aya Cafeは架空のカフェであり、実店舗はありません。</p></div></section>
</main>
<footer><div class="footer-top"><p>YOUR DRINK, YOUR MOOD.</p><nav aria-label="フッターナビゲーション">{nav.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav><a href="#" class="back-top" aria-label="ページの先頭へ">↑</a></div><p class="footer-word" aria-hidden="true">AYA CAFE<span>✳</span></p><div class="footer-bottom"><small>© Aya Cafe. All Rights Reserved.</small><small>FICTIONAL CAFE / PORTFOLIO PROJECT</small></div></footer>
<script src="../scripts/script.js"></script>
</body></html>
